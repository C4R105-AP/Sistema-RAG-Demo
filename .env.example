# Configuración del Sistema RAG Universal — 100% GRATUITO con Ollama
# Copia este archivo como .env

# === Servidor (solo local por defecto) ===
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Obligatorio para DELETE /limpiar. Si está vacío, el endpoint responde 403.
# RAG_ADMIN_TOKEN=

# === LLM local (recomendado si Ollama está instalado) ===
LLM_TYPE=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0
# Si Ollama no está instalado o no responde, el arranque usa modo demo (fake).
# LLM_TYPE=fake

# Embeddings (configurable; multilingüe por defecto)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chunking — RecursiveCharacterTextSplitter únicamente
CHUNK_SIZE=900
CHUNK_OVERLAP=200

# Retrieval híbrido: BM25 + semántica (RRF) → rerank → top DEFAULT_K
DEFAULT_K=8
RETRIEVAL_MULTIPLIER=4
CORPUS_SMALL_THRESHOLD=200
RRF_K=60

# Contexto
MAX_CHARS_CONTEXTO=7000
DEDUP_SIMILARITY_THRESHOLD=0.85

# Traducción del botón en /app (por defecto Google, online y rápido).
TRANSLATE_BACKEND=google
# TRANSLATE_BACKEND=deepl
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com
# Offline: TRANSLATE_BACKEND=marian  y TRANSLATE_MODEL=Helsinki-NLP/opus-mt-en-es
# Lento local: TRANSLATE_BACKEND=ollama

# Cross-encoder reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_WEIGHT_SIMILARITY=0.7
RERANK_WEIGHT_CROSS=0.3

# Debug (consola): modo (exhaustiva/ampliada/hibrida), BM25, similarity, RRF
# DEBUG_RAG=true
# DEBUG_SIMILARITY_TOP_N=30
# DEBUG_PREVIEW_CHARS=300

# === Otras opciones (de pago) ===
# LLM_TYPE=openai
# OPENAI_API_KEY=

# LLM_TYPE=anthropic
# ANTHROPIC_API_KEY=

# === Modo demo (sin IA real) ===
# LLM_TYPE=fake
